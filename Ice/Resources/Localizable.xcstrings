      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "правый клик"
          }
        }
      }
    },
    "Right-click in an empty area of the menu bar to display a minimal version of Ice's menu. Disable this setting if you encounter conflicts with other apps.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правый клик по пустой области строки меню показывает компактное меню Ice. Отключите, если возникают конфликты с другими приложениями."
          }
        }
      }
    },
    "Round Cap": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Круглый конец"
          }
        }
      }
    },
    "Scroll or swipe in the menu bar to show hidden menu bar items.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прокручивайте или смахивайте в строке меню, чтобы показать скрытые элементы."
          }
        }
      }
    },
    "Search menu bar items": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск элементов строки меню"
          }
        }
