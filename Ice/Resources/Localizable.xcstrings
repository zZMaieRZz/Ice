    },
    "Search menu bar items…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск элементов строки меню…"
          }
        }
      }
    },
    "Section divider style": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стиль разделителей"
          }
