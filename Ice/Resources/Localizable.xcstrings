{
  "sourceLanguage": "en",
  "strings": {
    "%@ Item": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Элемент «%@»"
          }
        }
      }
    },
    "•": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "•"
          }
        }
      }
    },
    "1": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "1"
          }
        }
      }
    },
    "2": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "2"
          }
        }
      }
    },
    "3": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "3"
          }
        }
      }
    },
    "Absolutely no personal information is collected or stored.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Личные данные не собираются и не хранятся."
          }
        }
      }
    },
    "Acknowledgements": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Благодарности"
          }
        }
      }
    },
    "Apply": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применить"
          }
        }
      }
    },
    "Apply different settings based on the current system appearance.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применять разные настройки в зависимости от текущей темы системы."
          }
        }
      }
    },
    "Apply the current spacing": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применить текущее расстояние"
          }
        }
      }
    },
    "Applying this setting will relaunch all apps with menu bar items. Some apps may need to be manually relaunched.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применение этой настройки перезапустит все приложения с элементами строки меню. Некоторые приложения может потребоваться перезапустить вручную."
          }
        }
      }
    },
    "Automatically check for updates": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически проверять обновления"
          }
        }
      }
    },
    "Automatically download updates": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически загружать обновления"
          }
        }
      }
    },
    "Automatically rehide": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически скрывать"
          }
        }
      }
    },
    "BETA": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "БЕТА"
          }
        }
      }
    },
    "Border": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рамка"
          }
        }
      }
    },
    "Border Color": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цвет рамки"
          }
        }
      }
    },
    "Border Width": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ширина рамки"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмена"
          }
        }
      }
    },
    "Check for Updates": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверить обновления"
          }
        }
      }
    },
    "Chevron": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шеврон"
          }
        }
      }
    },
    "Choose a custom icon to show in the menu bar.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите пользовательский значок для строки меню."
          }
        }
      }
    },
    "Choose image…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбрать изображение…"
          }
        }
      }
    },
    "Click inside an empty area of the menu bar to show hidden menu bar items.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Щёлкните по пустой области строки меню, чтобы показать скрытые элементы."
          }
        }
      }
    },
    "Click to show hidden menu bar items. Right-click to access Ice's settings.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Щёлкните, чтобы показать скрытые элементы строки меню. Правый клик — настройки Ice."
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжить"
          }
        }
      }
    },
    "Continue in Limited Mode": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжить в ограниченном режиме"
          }
        }
      }
    },
    "Contribute": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Участвовать"
          }
        }
      }
    },
    "Custom icon uses dynamic appearance": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пользовательский значок использует динамический вид"
          }
        }
      }
    },
    "Dark Appearance": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тёмный вид"
          }
        }
      }
    },
    "default": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "по умолчанию"
          }
        }
      }
    },
    "Display the icon as a monochrome image that dynamically adjusts to match the menu bar's appearance. This setting removes all color from the icon, but ensures consistent rendering with both light and dark backgrounds.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отображать значок как монохромный и динамически подстраивать под строку меню. Настройка убирает цвет, но обеспечивает одинаковый вид на светлом и тёмном фоне."
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово"
          }
        }
      }
    },
    "Drag to arrange your menu bar items into different sections.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетаскивайте элементы строки меню между разделами."
          }
        }
      }
    },
    "Dynamic": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Динамически"
          }
        }
      }
    },
    "Enable secondary context menu": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включить дополнительное контекстное меню"
          }
        }
      }
    },
    "Enable the always-hidden section": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включить постоянно скрытый раздел"
          }
        }
      }
    },
    "Enable the Ice Bar": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включить Ice Bar"
          }
        }
      }
    },
    "ERROR": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ошибка"
          }
        }
      }
    },
    "Focused app": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Активное приложение"
          }
        }
      }
    },
    "Full": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полная"
          }
        }
      }
    },
    "Go to Advanced Settings": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перейти к дополнительным настройкам"
          }
        }
      }
    },
    "Gradient": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Градиент"
          }
        }
      }
    },
    "Grant Permission": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предоставить разрешение"
          }
        }
      }
    },
    "Hide app menus when showing menu bar items": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрывать меню приложений при показе элементов строки меню"
          }
        }
      }
    },
    "Hold to Preview": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживать для предпросмотра"
          }
        }
      }
    },
    "Hotkey is reserved by macOS": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сочетание зарезервировано macOS"
          }
        }
      }
    },
    "Hover over an empty area of the menu bar to show hidden menu bar items.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наведите указатель на пустую область строки меню, чтобы показать скрытые элементы."
          }
        }
      }
    },
    "Ice": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice"
          }
        }
      }
    },
    "Ice can work in a limited mode without this permission.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без этого разрешения Ice может работать в ограниченном режиме."
          }
        }
      }
    },
    "Ice cannot arrange menu bar items in automatically hidden menu bars.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice не может упорядочивать элементы строки меню при автоматически скрываемой строке меню."
          }
        }
      }
    },
    "Ice cannot display menu bar items for automatically hidden menu bars": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice не может отображать элементы строки меню при автоматически скрываемой строке меню"
          }
        }
      }
    },
    "Ice cannot edit the appearance of automatically hidden menu bars.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice не может изменять внешний вид автоматически скрываемой строки меню."
          }
        }
      }
    },
    "Ice icon": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значок Ice"
          }
        }
      }
    },
    "Ice needs this to:": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice необходимо это для:"
          }
        }
      }
    },
    "Ice needs your permission to manage the menu bar.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice требуется ваше разрешение для управления строкой меню."
          }
        }
      }
    },
    "Items can also be arranged by ⌘ Command + dragging them in the menu bar.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Элементы также можно упорядочивать перетаскиванием с ⌘ Command в строке меню."
          }
        }
      }
    },
    "Last checked: %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последняя проверка: %@"
          }
        }
      }
    },
    "Leading End Cap": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начальный конец"
          }
        }
      }
    },
    "left click": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "левый клик"
          }
        }
      }
    },
    "Light Appearance": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Светлый вид"
          }
        }
      }
    },
    "Loading menu bar items…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузка элементов строки меню…"
          }
        }
      }
    },
    "Location": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расположение"
          }
        }
      }
    },
    "Make more room in the menu bar by hiding the current app menus if needed. macOS requires Ice to make itself visible in the Dock while this setting is in effect.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Освобождать место в строке меню, при необходимости скрывая меню текущего приложения. Пока настройка включена, macOS требует показывать Ice в Dock."
          }
        }
      }
    },
    "max": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "макс."
          }
        }
      }
    },
    "Menu bar item spacing": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расстояние между элементами строки меню"
          }
        }
      }
    },
    "Menu Bar Items": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Элементы строки меню"
          }
        }
      }
    },
    "Menu bar items are rehidden after a fixed amount of time.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Элементы строки меню скрываются через заданное время."
          }
        }
      }
    },
    "Menu bar items are rehidden using a smart algorithm.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Элементы строки меню скрываются по умному алгоритму."
          }
        }
      }
    },
    "Menu bar items are rehidden when the focused app changes.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Элементы строки меню скрываются при смене активного приложения."
          }
        }
      }
    },
    "Menu bar layout requires screen recording permissions.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для раскладки строки меню требуется разрешение на запись экрана."
          }
        }
      }
    },
    "Menu Bar Sections": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разделы строки меню"
          }
        }
      }
    },
    "Menu Bar Shape": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Форма строки меню"
          }
        }
      }
    },
